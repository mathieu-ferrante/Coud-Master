# Copier ce fichier en .env. Le fichier .env n'est jamais versionné.

# --- Base de données ---------------------------------------------------------
# PostgreSQL local, lancé avec « docker compose up -d ».
POSTGRES_USER=ffk
POSTGRES_PASSWORD=ffk-local-only
POSTGRES_DB=ffk
# Adresse de connexion utilisée par le backend. 127.0.0.1 plutôt que localhost : sous Windows,
# « localhost » peut tenter IPv6 d'abord et faire attendre la connexion.
DATABASE_URL=postgresql+psycopg://ffk:ffk-local-only@127.0.0.1:5400/ffk

# --- Frontend <-> backend ----------------------------------------------------
# Origines du frontend autorisées à appeler le backend, séparées par des virgules.
CORS_ORIGINS=http://localhost:5173
# Adresse du backend vue par le navigateur. Intégrée au frontend à la compilation.
VITE_API_URL=http://localhost:8000

# --- Stockage des PDF ---------------------------------------------------------
# Vide : PDF dans backend/data/documents (local). Renseignée : PDF dans Azure Blob Storage.
# Chaîne de connexion : compte de stockage > Clés d'accès. Secrète.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents

# --- Fournisseur LLM (à compléter) -------------------------------------------
# API compatible « chat/completions » avec le mode JSON. Voir « Connecter un fournisseur LLM » dans le README.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
